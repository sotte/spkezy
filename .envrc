# .envrc - https://github.com/direnv/direnv
export VIRTUAL_ENV=".venv"
layout python

# On NixOS: add nix-ld library path so Python packages can find system libraries
# NIX_LD_LIBRARY_PATH is set by the system to /run/current-system/sw/share/nix-ld/lib
if [ -n "$NIX_LD_LIBRARY_PATH" ]; then
    export LD_LIBRARY_PATH="${NIX_LD_LIBRARY_PATH}:${LD_LIBRARY_PATH}"
fi
