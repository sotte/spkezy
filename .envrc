# .envrc - https://github.com/direnv/direnv
export VIRTUAL_ENV=".venv"
layout python

# On NixOS: add nix-ld library path so Python packages can find system libraries
# NIX_LD_LIBRARY_PATH is set by the system to /run/current-system/sw/share/nix-ld/lib
if [ -n "$NIX_LD_LIBRARY_PATH" ]; then
    export LD_LIBRARY_PATH="${NIX_LD_LIBRARY_PATH}:${LD_LIBRARY_PATH}"
fi

# Add portaudio from nix store for pyaudio compilation
# Find portaudio in nix store and add to library and include paths
PORTAUDIO_LIB=$(find /nix/store -maxdepth 1 -name "*portaudio*" -type d 2>/dev/null | head -1)
if [ -n "$PORTAUDIO_LIB" ] && [ -d "$PORTAUDIO_LIB/lib" ]; then
    export LD_LIBRARY_PATH="$PORTAUDIO_LIB/lib:${LD_LIBRARY_PATH}"
    export LIBRARY_PATH="$PORTAUDIO_LIB/lib:${LIBRARY_PATH}"  # For compile-time linking
    export C_INCLUDE_PATH="$PORTAUDIO_LIB/include:${C_INCLUDE_PATH}"
    export CPLUS_INCLUDE_PATH="$PORTAUDIO_LIB/include:${CPLUS_INCLUDE_PATH}"
fi
